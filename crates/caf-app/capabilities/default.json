{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-window-minimize",
    "allow-window-maximize",
    "allow-window-close",
    "allow-window-show",
    "allow-window-start-dragging",
    "allow-is-vault-initialized",
    "allow-validate-vault-password",
    "allow-lock-vault",
    "allow-change-master-password",
    "allow-reset-vault",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-verify-pin",
    "allow-list-notes",
    "allow-save-note",
    "allow-delete-note",
    "allow-get-ai-settings",
    "allow-save-ai-settings",
    "allow-set-ai-api-key",
    "allow-clear-ai-api-key",
    "allow-ai-preview-context",
    "allow-ai-chat",
    "allow-test-ai-connection",
    "allow-submit-feedback",
    "allow-get-pending-crash-report",
