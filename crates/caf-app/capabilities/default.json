    "allow-workspace-delete-file",
    "allow-workspace-reveal-file",
    "allow-workspace-copy-file",
    "allow-get-initial-file-path",
    "allow-vault-list-documents",
    "allow-vault-save-document",
    "allow-vault-delete-document",
    "allow-export-document-html",
    "allow-export-document-pdf",
    "allow-ai-copilot-action",
    "allow-pro-status",
    "allow-pro-server-available",
    "allow-pro-login",
    "allow-pro-register",
    "allow-pro-activate-license",
    "allow-pro-logout",
    "dialog:default",
    "process:default",
    "fs:default"
